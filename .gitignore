# Large plot files that shouldn't be committed
*.lpt
SMDAMAGE revenue neutral/Output/*.lpt
Data/*.lpt
Data/*.db

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.env

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Large data files over 100MB
*.pkl
!small_*.pkl

# Temporary files
*.tmp
*.temp
*~
